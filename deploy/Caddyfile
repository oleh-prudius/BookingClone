{$DOMAIN} {
	# API controllers, SignalR hub and uploaded file storage all live on the
	# api container; everything else is the static frontend build.
	handle /api/* {
		reverse_proxy api:8080
	}

	handle /hubs/* {
		reverse_proxy api:8080
	}

	handle /uploads/* {
		reverse_proxy api:8080
	}

	# Self-hosted Umami analytics (admin UI + tracking script), served under a
	# subpath so it doesn't need its own domain/port. Umami's BASE_PATH env var
	# (set in docker-compose.prod.yml) must match this prefix.
	handle_path /umami/* {
		reverse_proxy umami:3000
	}

	handle {
		reverse_proxy frontend:80
	}
}
