# Copy to .env and adjust. Used by docker-compose.
# .env is gitignored — never commit real secrets.

# --- PostgreSQL ---
# Used to configure the local `db` container (below) AND as the default
# connection string for the API, unless DATABASE_CONNECTION_STRING is set.
POSTGRES_DB=bookingclone
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Database connection used by the API ---
# Defaults to the local `db` container above (fresh, empty DB per machine).
# Replace with a remote Postgres connection string (e.g. Neon) to point the API
# at a shared database instead — useful when multiple people need to see the
# same users/admins/objects. When using a remote DB, the local `db` container
# is still started by compose but unused; skip it with `docker compose up api frontend`.
DATABASE_CONNECTION_STRING=Host=db;Port=5432;Database=bookingclone;Username=postgres;Password=postgres

# --- JWT signing key (min 32 chars) ---
# Generate one with: openssl rand -base64 32
JWT_KEY=change-me-to-a-random-key-at-least-32-chars

# --- URLs ---
FRONTEND_URL=http://localhost:5173
SERVER_RUN_URL=http://localhost:5134
# Baked into the frontend bundle at build time
VITE_API_BASE_URL=http://localhost:5134/api

# --- Seeded admin account (created on first run) ---
ADMIN_EMAIL=admin@bookingclone.dev
ADMIN_PASSWORD=Admin@123456

# --- SMTP (optional; leave blank to disable outgoing email) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@bookingclone.com
SMTP_ENABLE_SSL=true
